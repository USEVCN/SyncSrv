<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>%level %logger{24} - %msg%n</pattern></encoder></appender>
  <logger name="org.apache.ftpserver" level="ERROR"/>
  <logger name="org.apache.sshd" level="ERROR"/>
  <logger name="net.schmizz" level="OFF"/>
  <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
