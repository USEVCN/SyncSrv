# 本文件由 /bin/sh 读取。密码使用单引号，反斜杠按实际字符保留。
# 不要将包含真实密码的文件加入安装包或版本库。
SYNCSRV_PRODUCTION=true
SYNCSRV_PORT=18010
SYNCSRV_BIND=127.0.0.1
SYNCSRV_DATA=/var/lib/syncsrv
# 默认使用数据目录内的 H2 文件数据库，无需安装外部数据库或填写账号。
# 只在首次初始化管理员时使用。已有数据库以保存的密码哈希为准。
SYNCSRV_INITIAL_PASSWORD=''
SYNCSRV_HEAP_MIN_MIB=64
SYNCSRV_HEAP_MAX_MIB=512

SYNCSRV_CENTER_RELEASES=/opt/syncsrv/center-releases
